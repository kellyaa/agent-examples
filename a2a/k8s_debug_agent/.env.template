# Logging
LOG_LEVEL=INFO

# A2A Server Configuration
A2A_HOST=0.0.0.0
SERVICE_PORT=8000

# MCP Server Configuration
K8S_MCP=http://localhost:8001/mcp/
GITHUB_MCP=http://localhost:8002/mcp/
GITHUB_TOKEN=your-github-token-here

# LLM Configuration (any OpenAI-compatible endpoint)
LLM_MODEL=gpt-4
LLM_API_KEY=your-api-key-here
LLM_API_BASE=https://api.openai.com/v1
LLM_TEMPERATURE=0.0
EXTRA_HEADERS='{}' # Optional: JSON string of extra headers

# Execution Limits
MAX_PLAN_STEPS=15
MAX_TOOL_RESPONSE_CHARS=50000  # Max chars per MCP tool response (0 = unlimited)

# Public URL advertised in Agent Card (optional)
# A2A_PUBLIC_URL=http://localhost:8000/

# Tracing
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317  # OTLP endpoint (e.g. Jaeger, Grafana Tempo)
OTEL_CONSOLE_TRACING=false  # Print traces to console when no OTLP endpoint is set
